{
  "name": "quan-ly-hoc-tap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "local": "node scripts/run-local.mjs",
    "local:db": "wrangler d1 migrations apply learning-management-db --local --config wrangler.local.jsonc",
    "local:doctor": "node scripts/local-system-doctor.mjs",
    "local:doctor:strict": "node scripts/local-system-doctor.mjs --strict-ports",
    "local:system": "node scripts/run-local-offline-v2.mjs",
    "run:all": "node scripts/run-all.mjs --local",
    "local:system:hybrid": "node scripts/run-local-system.mjs --hybrid",
    "local:offline-smoke": "node scripts/local-offline-smoke.mjs",
    "build": "bash scripts/build-verified.sh",
    "preview": "npm run build && vite preview",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "validate:local-first": "node --test tests/local-first-runtime.test.mjs",
    "validate:cloudflare-preview": "node scripts/validate-cloudflare-preview.mjs",
    "cloudflare:preview:prepare": "node scripts/prepare-cloudflare-preview.mjs",
    "cloudflare:check": "node scripts/validate-cloudflare-ready.mjs",
    "cloudflare:artifact:check": "node scripts/validate-cloudflare-build-artifact.mjs",
    "preview:verify": "node scripts/verify-preview-stack.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "projects:check": "node scripts/check-project-repositories.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Application Management"
}
