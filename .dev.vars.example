# Local-only development identity. Never copy LOCAL_DEV_AUTH=1 into production.
LOCAL_DEV_AUTH=1
LOCAL_DEV_USER_ID=local-owner
LOCAL_DEV_USER_EMAIL=local.owner@example.test
LOCAL_DEV_USER_NAME=Local Owner
CONTROL_OWNER_EMAILS=local.owner@example.test

# Optional Google OAuth/OIDC for Production-like local testing.
# Create a Google OAuth 2.0 Web client and register:
# http://localhost:<port>/__auth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:<port>/__auth/google/callback

# Optional client bridges for full-stack local testing.
# Start each independent client on its own loopback port and use the same local-only secret on both sides.
# Prefer the explicit *_LOCAL_* variables below rather than putting private HTTP origins in production *_BASE_URL variables.
# HEALTH_CARE_LOCAL_BASE_URL=http://127.0.0.1:3001
# HEALTH_CONTROL_SERVICE_LOCAL_SECRET=local-only-health-control-secret-change-me-0001
# RU_LIFE_LOCAL_BASE_URL=http://127.0.0.1:3002
# RU_LIFE_CONTROL_SERVICE_LOCAL_SECRET=local-only-ru-control-secret-change-me-0001
# BAUMAN_CONTROL_LOCAL_BASE_URL=http://127.0.0.1:3003
# BAUMAN_APP_LOCAL_ORIGIN=http://127.0.0.1:3005
# BAUMAN_CONTROL_SERVICE_LOCAL_SECRET=local-only-bauman-control-secret-change-me-0001
# BOI_ECH_LOCAL_BASE_URL=http://127.0.0.1:3004
# CONTROL_SERVICE_LOCAL_SECRET=local-only-boi-control-secret-change-me-0001


# PriceReport Tùng Gia Bảo is a static GitHub Pages client in phase 1.
# Override only when testing another deployment origin.
# PRICE_REPORT_BASE_URL=https://bluedragon33.github.io/PriceReport_Tunggiabao


# PriceReport KT Control Service
# PRICE_REPORT_CONTROL_LOCAL_BASE_URL=http://127.0.0.1:3006
# PRICE_REPORT_CONTROL_BASE_URL=https://<price-report-control-worker-origin>
# PRICE_REPORT_CONTROL_SERVICE_SECRET=local-only-price-report-control-secret-change-me-0001
# PRICE_REPORT_BASE_URL=https://bluedragon33.github.io/PriceReport_Tunggiabao

# Optional Hybrid fallback to Cloudflare Production.
# Keep these production values only in local untracked .dev.vars when remote fallback is desired.
# HEALTH_CARE_BASE_URL=https://<health-production-origin>
# HEALTH_CONTROL_SERVICE_SECRET=<health-production-secret>
# RU_LIFE_BASE_URL=https://<ru-life-production-origin>
# RU_LIFE_CONTROL_SERVICE_SECRET=<ru-life-production-secret>
# BAUMAN_CONTROL_BASE_URL=https://bauman-control.boiech-ai.workers.dev
# BAUMAN_APP_ORIGIN=https://bauman-master-ai.boiech-ai.workers.dev
# BAUMAN_CONTROL_SERVICE_SECRET=<bauman-production-secret>
# BOI_ECH_BASE_URL=https://<boi-ech-production-origin>
# CONTROL_SERVICE_SECRET=<boi-ech-production-secret>


# Dynamic Managed App Catalog
# One-time root key used to AES-GCM encrypt per-app management credentials in D1.
# Generate exactly 32 random bytes and encode URL-safe base64 without padding (43 chars).
# MANAGED_APP_CREDENTIAL_ENCRYPTION_KEY=<43-char-url-safe-key>


# Deploy & Ops provider credentials (local-only / Worker secrets).
# Never commit real values. Production/Preview install these through protected GitHub environment secrets
# or directly as Cloudflare Worker secrets.
# VERCEL_TOKEN=<vercel personal-or-team-token>
# NEON_API_KEY=<neon-api-key>
# TINYFISH_API_KEY=<tinyfish-api-key>
